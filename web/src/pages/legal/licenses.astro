---
import LegalLayout from '../../layouts/LegalLayout.astro';
---

<LegalLayout
  title="Open Source Licenses"
  description="PayDart is free and open-source software built on top of transparent open-source libraries."
  lastUpdated="September 2026"
>
  <div class="space-y-8 text-zinc-300">
    <section>
      <h2 class="text-2xl font-bold text-white mb-3">PayDart License (Apache 2.0)</h2>
      <p class="mb-4">
        Copyright 2026 AJAYMYTH
      </p>
      <div class="p-4 rounded-xl bg-white/[0.03] border border-white/10 font-mono text-xs text-zinc-400 overflow-x-auto leading-relaxed">
        Licensed under the Apache License, Version 2.0 (the "License");
        you may not use this file except in compliance with the License.
        You may obtain a copy of the License at<br/><br/>
        http://www.apache.org/licenses/LICENSE-2.0<br/><br/>
        Unless required by applicable law or agreed to in writing, software
        distributed under the License is distributed on an "AS IS" BASIS,
        WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
        See the License for the specific language governing permissions and
        limitations under the License.
      </div>
    </section>

    <section>
      <h2 class="text-2xl font-bold text-white mb-4">Third-Party Software &amp; Attributions</h2>
      
      <div class="space-y-4">
        <div class="p-5 rounded-2xl glass-panel border-white/10">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-white">Google ML Kit Barcode Scanning</span>
            <span class="text-xs font-mono text-[#00F076]">Apache 2.0</span>
          </div>
          <p class="text-xs text-zinc-400">On-device machine learning barcode extraction engine developed by Google LLC.</p>
        </div>

        <div class="p-5 rounded-2xl glass-panel border-white/10">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-white">Android Jetpack CameraX &amp; Compose</span>
            <span class="text-xs font-mono text-[#00F076]">Apache 2.0</span>
          </div>
          <p class="text-xs text-zinc-400">Modern Android camera lifecycle bindings and declarative UI toolkit by Google LLC.</p>
        </div>

        <div class="p-5 rounded-2xl glass-panel border-white/10">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-white">Lucide Icons</span>
            <span class="text-xs font-mono text-[#00F076]">ISC License</span>
          </div>
          <p class="text-xs text-zinc-400">Crisp, beautiful open-source iconography by the Lucide project.</p>
        </div>

        <div class="p-5 rounded-2xl glass-panel border-white/10">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-white">Anime.js</span>
            <span class="text-xs font-mono text-[#00F076]">MIT License</span>
          </div>
          <p class="text-xs text-zinc-400">Lightweight JavaScript animation engine created by Julian Garnier.</p>
        </div>

        <div class="p-5 rounded-2xl glass-panel border-white/10">
          <div class="flex items-center justify-between mb-2">
            <span class="font-bold text-white">Astro</span>
            <span class="text-xs font-mono text-[#00F076]">MIT License</span>
          </div>
          <p class="text-xs text-zinc-400">The web framework for content-driven websites by Astro Technology Company.</p>
        </div>
      </div>
    </section>
  </div>
</LegalLayout>

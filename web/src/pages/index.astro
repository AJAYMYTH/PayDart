---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProblemSolution from '../components/ProblemSolution.astro';
import PerformanceMetrics from '../components/PerformanceMetrics.astro';
import FeaturesGrid from '../components/FeaturesGrid.astro';
import SupportedApps from '../components/SupportedApps.astro';
import DownloadCard from '../components/DownloadCard.astro';
import TerminalInstall from '../components/TerminalInstall.astro';
import FAQ from '../components/FAQ.astro';
import BigFooter from '../components/BigFooter.astro';
---

<Layout
  title="PayDart — Ultra-Fast Native UPI QR Launcher (<10ms) | 100% Offline"
  description="Point, scan UPI QR codes in 8 milliseconds, and hand off instantly to Google Pay, PhonePe, Paytm, or CRED with zero ads, zero bloat, and 100% offline air-gapped privacy."
>
  <Navbar />
  
  <main class="flex-1">
    <Hero />
    <ProblemSolution />
    <PerformanceMetrics />
    <FeaturesGrid />
    <SupportedApps />
    <DownloadCard />
    <TerminalInstall />
    <FAQ />
  </main>

  <BigFooter />
</Layout>

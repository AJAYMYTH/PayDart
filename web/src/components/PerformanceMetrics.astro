---
import { Zap, Gauge, HardDrive, WifiOff, Cpu, Clock, Check } from '@lucide/astro';
import Badge from './ui/Badge.astro';
---

<section id="benchmarks" class="py-20 md:py-28 relative scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-3xl mx-auto mb-16 reveal-on-scroll">
      <Badge variant="cyber" class="mb-4">
        <Gauge class="w-3.5 h-3.5" />
        EMPIRICAL BENCHMARKS
      </Badge>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight text-white mb-4">
        Engineered for <span class="text-gradient-emerald">Sub-10ms Latency.</span>
      </h2>
      <p class="text-zinc-400 text-base sm:text-lg">
        Benchmarked on mid-range Android hardware (Snapdragon 778G, 6GB RAM, Android 14) under identical lighting and standard merchant QR codes.
      </p>
    </div>

    <!-- Animated Counters Grid (4 columns) -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-16 reveal-on-scroll">
      <!-- Metric 1: Scan Latency -->
      <div class="glass-panel p-6 sm:p-8 rounded-2xl border-white/10 hover:border-[#00F076]/40 transition-all duration-300">
        <div class="w-10 h-10 rounded-xl bg-[#00F076]/15 flex items-center justify-center text-[#00F076] mb-4">
          <Zap class="w-5 h-5" />
        </div>
        <div class="text-3xl sm:text-4xl font-mono font-extrabold text-[#00F076] mb-1">
          <span class="stat-counter" data-target="8" data-suffix=" ms">0 ms</span>
        </div>
        <div class="text-sm font-bold text-white mb-1">QR Scan Latency</div>
        <div class="text-xs text-zinc-400 leading-relaxed">
          Pre-warmed ML Kit C++ detector eliminates barcode cold-start penalty.
        </div>
      </div>

      <!-- Metric 2: App Size -->
      <div class="glass-panel p-6 sm:p-8 rounded-2xl border-white/10 hover:border-[#00F076]/40 transition-all duration-300">
        <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-white mb-4">
          <HardDrive class="w-5 h-5 text-[#00F076]" />
        </div>
        <div class="text-3xl sm:text-4xl font-mono font-extrabold text-white mb-1">
          <span class="stat-counter" data-target="4.8" data-decimals="1" data-suffix=" MB">0 MB</span>
        </div>
        <div class="text-sm font-bold text-white mb-1">Total APK Size</div>
        <div class="text-xs text-zinc-400 leading-relaxed">
          Lean, single-purpose binary with zero third-party bloated SDKs.
        </div>
      </div>

      <!-- Metric 3: Cold Start -->
      <div class="glass-panel p-6 sm:p-8 rounded-2xl border-white/10 hover:border-[#00F076]/40 transition-all duration-300">
        <div class="w-10 h-10 rounded-xl bg-[#00F076]/15 flex items-center justify-center text-[#00F076] mb-4">
          <Clock class="w-5 h-5" />
        </div>
        <div class="text-3xl sm:text-4xl font-mono font-extrabold text-[#00F076] mb-1">
          <span class="stat-counter" data-target="180" data-suffix=" ms">0 ms</span>
        </div>
        <div class="text-sm font-bold text-white mb-1">Camera Launch Speed</div>
        <div class="text-xs text-zinc-400 leading-relaxed">
          Instant viewfinder binding via CameraX 1.4 lifecycle pipeline.
        </div>
      </div>

      <!-- Metric 4: Offline Airgap -->
      <div class="glass-panel p-6 sm:p-8 rounded-2xl border-white/10 hover:border-[#00F076]/40 transition-all duration-300">
        <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-white mb-4">
          <WifiOff class="w-5 h-5 text-[#00F076]" />
        </div>
        <div class="text-3xl sm:text-4xl font-mono font-extrabold text-white mb-1">
          <span class="stat-counter" data-target="0" data-suffix=" calls">0 calls</span>
        </div>
        <div class="text-sm font-bold text-white mb-1">Network Telemetry</div>
        <div class="text-xs text-zinc-400 leading-relaxed">
          Zero internet permissions declared. 100% on-device local execution.
        </div>
      </div>
    </div>

    <!-- Comparative Visual Bars -->
    <div class="glass-panel p-8 sm:p-10 rounded-3xl border-white/10 reveal-on-scroll">
      <h3 class="text-xl sm:text-2xl font-bold text-white mb-6 flex items-center gap-2">
        <Cpu class="w-5 h-5 text-[#00F076]" />
        Direct Head-to-Head Architecture Benchmark
      </h3>

      <div class="space-y-6">
        <!-- Bar 1: Cold Start -->
        <div>
          <div class="flex justify-between text-xs sm:text-sm font-mono mb-2">
            <span class="text-white font-semibold">Cold Start to Viewfinder Ready</span>
            <span class="text-[#00F076] font-bold">PayDart 30x Faster</span>
          </div>
          <div class="space-y-1.5">
            <div class="flex items-center gap-3">
              <span class="w-24 text-xs font-mono text-zinc-400">PayDart</span>
              <div class="flex-1 bg-white/5 h-4 rounded-full overflow-hidden p-0.5">
                <div class="bg-gradient-to-r from-[#00F076] to-[#10B981] h-full rounded-full w-[5%] shadow-[0_0_10px_#00F076]"></div>
              </div>
              <span class="w-16 text-right font-mono text-xs font-bold text-[#00F076]">180 ms</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-24 text-xs font-mono text-zinc-400">Standard Apps</span>
              <div class="flex-1 bg-white/5 h-4 rounded-full overflow-hidden p-0.5">
                <div class="bg-zinc-600 h-full rounded-full w-[95%]"></div>
              </div>
              <span class="w-16 text-right font-mono text-xs text-zinc-400">5,400 ms</span>
            </div>
          </div>
        </div>

        <!-- Bar 2: App Size -->
        <div>
          <div class="flex justify-between text-xs sm:text-sm font-mono mb-2">
            <span class="text-white font-semibold">Disk Space Footprint</span>
            <span class="text-[#00F076] font-bold">97% Less Storage</span>
          </div>
          <div class="space-y-1.5">
            <div class="flex items-center gap-3">
              <span class="w-24 text-xs font-mono text-zinc-400">PayDart</span>
              <div class="flex-1 bg-white/5 h-4 rounded-full overflow-hidden p-0.5">
                <div class="bg-gradient-to-r from-[#00F076] to-[#10B981] h-full rounded-full w-[3%] shadow-[0_0_10px_#00F076]"></div>
              </div>
              <span class="w-16 text-right font-mono text-xs font-bold text-[#00F076]">4.8 MB</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-24 text-xs font-mono text-zinc-400">Standard Apps</span>
              <div class="flex-1 bg-white/5 h-4 rounded-full overflow-hidden p-0.5">
                <div class="bg-zinc-600 h-full rounded-full w-[98%]"></div>
              </div>
              <span class="w-16 text-right font-mono text-xs text-zinc-400">165 MB</span>
            </div>
          </div>
        </div>

        <!-- Bar 3: Background Memory -->
        <div>
          <div class="flex justify-between text-xs sm:text-sm font-mono mb-2">
            <span class="text-white font-semibold">Active RAM Consumption</span>
            <span class="text-[#00F076] font-bold">16x Less Memory</span>
          </div>
          <div class="space-y-1.5">
            <div class="flex items-center gap-3">
              <span class="w-24 text-xs font-mono text-zinc-400">PayDart</span>
              <div class="flex-1 bg-white/5 h-4 rounded-full overflow-hidden p-0.5">
                <div class="bg-gradient-to-r from-[#00F076] to-[#10B981] h-full rounded-full w-[6%] shadow-[0_0_10px_#00F076]"></div>
              </div>
              <span class="w-16 text-right font-mono text-xs font-bold text-[#00F076]">14 MB</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-24 text-xs font-mono text-zinc-400">Standard Apps</span>
              <div class="flex-1 bg-white/5 h-4 rounded-full overflow-hidden p-0.5">
                <div class="bg-zinc-600 h-full rounded-full w-[92%]"></div>
              </div>
              <span class="w-16 text-right font-mono text-xs text-zinc-400">230 MB</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

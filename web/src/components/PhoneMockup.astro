---
import { Zap, ShieldCheck, Image, Flashlight, Settings, ArrowRight } from '@lucide/astro';
---

<div class="relative w-full max-w-[340px] sm:max-w-[360px] mx-auto phone-mockup-float">
  <!-- Glowing background aura -->
  <div class="absolute -inset-4 bg-gradient-to-tr from-[#00F076]/20 via-[#10B981]/10 to-transparent rounded-[48px] blur-2xl pointer-events-none"></div>

  <!-- Outer Phone Chassis -->
  <div class="relative rounded-[44px] p-3 bg-gradient-to-b from-zinc-700 via-zinc-900 to-black border-2 border-white/20 shadow-[0_25px_60px_-15px_rgba(0,0,0,0.9),0_0_40px_rgba(0,240,118,0.15)]">
    <!-- Camera speaker grill / punch hole -->
    <div class="absolute top-5 left-1/2 -translate-x-1/2 w-20 h-4 bg-black rounded-full z-30 flex items-center justify-center">
      <div class="w-2.5 h-2.5 rounded-full bg-zinc-900 border border-zinc-700"></div>
    </div>

    <!-- Screen Bezel -->
    <div class="relative rounded-[36px] overflow-hidden bg-[#040805] aspect-[9/19] flex flex-col justify-between border border-white/10 select-none">
      <!-- Simulated Camera Viewport with subtle grid -->
      <div class="absolute inset-0 bg-[#08120b] cyber-grid opacity-80"></div>

      <!-- Live Scan Laser Line -->
      <div class="absolute left-0 right-0 h-1 bg-gradient-to-r from-transparent via-[#00F076] to-transparent scanner-laser z-20 shadow-[0_0_15px_#00F076]"></div>

      <!-- Top HUD Header -->
      <div class="relative z-20 pt-8 px-5 pb-3 flex items-center justify-between text-white/90 bg-gradient-to-b from-black/80 to-transparent">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full bg-[#00F076] animate-ping"></span>
          <span class="font-mono text-[11px] font-bold tracking-wider text-[#00F076]">RADAR // READY</span>
        </div>
        <div class="flex items-center gap-2">
          <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center text-zinc-300">
            <Flashlight class="w-3.5 h-3.5" />
          </div>
          <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center text-zinc-300">
            <Image class="w-3.5 h-3.5" />
          </div>
          <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center text-zinc-300">
            <Settings class="w-3.5 h-3.5" />
          </div>
        </div>
      </div>

      <!-- Center Reticle with QR Code Target -->
      <div class="relative z-10 flex-1 flex flex-col items-center justify-center px-6">
        <div class="relative w-48 h-48 sm:w-52 sm:h-52 flex items-center justify-center">
          <!-- Cyber Corner Markers -->
          <div class="absolute -top-1 -left-1 w-6 h-6 border-t-2 border-l-2 border-[#00F076] rounded-tl"></div>
          <div class="absolute -top-1 -right-1 w-6 h-6 border-t-2 border-r-2 border-[#00F076] rounded-tr"></div>
          <div class="absolute -bottom-1 -left-1 w-6 h-6 border-b-2 border-l-2 border-[#00F076] rounded-bl"></div>
          <div class="absolute -bottom-1 -right-1 w-6 h-6 border-b-2 border-r-2 border-[#00F076] rounded-br"></div>

          <!-- Simulated High-Res Merchant UPI QR Pattern -->
          <div class="w-40 h-40 bg-black/90 p-2.5 rounded-xl border border-white/20 shadow-inner flex flex-col items-center justify-center">
            <svg viewBox="0 0 100 100" class="w-full h-full fill-white" xmlns="http://www.w3.org/2000/svg">
              <!-- Top Left Corner Eye -->
              <rect x="5" y="5" width="28" height="28" rx="4" fill="none" stroke="#00F076" stroke-width="4" />
              <rect x="11" y="11" width="16" height="16" rx="2" fill="#00F076" />
              <!-- Top Right Corner Eye -->
              <rect x="67" y="5" width="28" height="28" rx="4" fill="none" stroke="#00F076" stroke-width="4" />
              <rect x="73" y="11" width="16" height="16" rx="2" fill="#00F076" />
              <!-- Bottom Left Corner Eye -->
              <rect x="5" y="67" width="28" height="28" rx="4" fill="none" stroke="#00F076" stroke-width="4" />
              <rect x="11" y="73" width="16" height="16" rx="2" fill="#00F076" />
              <!-- Random QR data matrices -->
              <rect x="38" y="12" width="6" height="6" fill="#FFFFFF" />
              <rect x="48" y="8" width="8" height="6" fill="#00F076" />
              <rect x="42" y="24" width="10" height="6" fill="#FFFFFF" />
              <rect x="12" y="42" width="6" height="8" fill="#FFFFFF" />
              <rect x="24" y="48" width="8" height="6" fill="#00F076" />
              <rect x="40" y="40" width="20" height="20" rx="3" fill="#00F076" fill-opacity="0.3" stroke="#00F076" stroke-width="2" />
              <path d="M48 45L45 52H49L47 57L54 49H50L52 45Z" fill="#00F076" />
              <rect x="68" y="42" width="8" height="8" fill="#FFFFFF" />
              <rect x="78" y="50" width="8" height="6" fill="#FFFFFF" />
              <rect x="42" y="70" width="12" height="6" fill="#00F076" />
              <rect x="68" y="72" width="6" height="12" fill="#FFFFFF" />
              <rect x="80" y="82" width="8" height="8" fill="#FFFFFF" />
            </svg>
          </div>

          <!-- Lock Confirmation Pill -->
          <div class="absolute -bottom-4 px-3 py-1 rounded-full bg-[#00F076] text-black font-mono text-[10px] font-extrabold tracking-wider shadow-[0_0_15px_#00F076] flex items-center gap-1">
            <Zap class="w-3 h-3 fill-black" />
            UPI LOCKED: 8ms
          </div>
        </div>
      </div>

      <!-- Floating Bottom Action Dock -->
      <div class="relative z-20 p-4 bg-gradient-to-t from-black via-black/95 to-transparent">
        <div class="p-3 rounded-2xl bg-white/[0.06] border border-white/10 backdrop-blur-md">
          <div class="flex items-center justify-between mb-2">
            <div>
              <div class="text-[10px] font-mono uppercase text-zinc-400">Target Payee</div>
              <div class="text-xs font-bold text-white flex items-center gap-1">
                Kiran Supermarket
                <ShieldCheck class="w-3 h-3 text-[#00F076]" />
              </div>
            </div>
            <div class="text-right">
              <div class="text-[10px] font-mono uppercase text-zinc-400">Amount</div>
              <div class="text-xs font-mono font-bold text-[#00F076]">₹ 140.00</div>
            </div>
          </div>

          <!-- Instant Launcher Bar -->
          <div class="w-full py-2 px-3 rounded-xl bg-gradient-to-r from-[#00F076] to-[#10B981] text-black font-bold text-xs flex items-center justify-between shadow-[0_0_20px_rgba(0,240,118,0.4)]">
            <span class="flex items-center gap-1.5">
              <Zap class="w-3.5 h-3.5 fill-black" />
              Launching PhonePe
            </span>
            <span class="font-mono text-[10px] bg-black/20 px-1.5 py-0.5 rounded flex items-center gap-1">
              &lt; 10ms <ArrowRight class="w-3 h-3" />
            </span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Floating Stats Floating Pill 1 (Left) -->
  <div class="absolute -left-6 top-28 hidden lg:flex items-center gap-2.5 px-3.5 py-2 rounded-xl bg-[#08120b]/90 border border-[#00F076]/40 backdrop-blur-md shadow-[0_10px_25px_rgba(0,0,0,0.5)]">
    <div class="w-7 h-7 rounded-lg bg-[#00F076]/15 flex items-center justify-center text-[#00F076]">
      <Zap class="w-4 h-4" />
    </div>
    <div>
      <div class="text-[10px] font-mono text-zinc-400">Scan Latency</div>
      <div class="text-xs font-mono font-bold text-white">&lt; 8 milliseconds</div>
    </div>
  </div>

  <!-- Floating Stats Floating Pill 2 (Right) -->
  <div class="absolute -right-6 bottom-32 hidden lg:flex items-center gap-2.5 px-3.5 py-2 rounded-xl bg-[#08120b]/90 border border-white/20 backdrop-blur-md shadow-[0_10px_25px_rgba(0,0,0,0.5)]">
    <div class="w-7 h-7 rounded-lg bg-white/10 flex items-center justify-center text-white">
      <ShieldCheck class="w-4 h-4 text-[#00F076]" />
    </div>
    <div>
      <div class="text-[10px] font-mono text-zinc-400">Network Permission</div>
      <div class="text-xs font-mono font-bold text-[#00F076]">0 Permissions • 100% Offline</div>
    </div>
  </div>
</div>

---
import { Download, QrCode, ShieldCheck, Zap, ArrowRight, Sparkles } from '@lucide/astro';
import Button from './ui/Button.astro';
import Badge from './ui/Badge.astro';
import GithubIcon from './ui/GithubIcon.astro';
import PhoneMockup from './PhoneMockup.astro';

const downloadUrl = 'https://github.com/AJAYMYTH/PayDart/releases/latest/download/app-debug.apk';
const githubUrl = 'https://github.com/AJAYMYTH/PayDart';
---

<section class="relative pt-12 pb-20 md:pt-20 md:pb-32 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      <!-- Left Content (7 cols) -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
        <!-- Status Pill -->
        <div class="hero-anime mb-6">
          <Badge variant="cyber" class="gap-2 px-3.5 py-1.5 text-xs">
            <span class="w-2 h-2 rounded-full bg-[#00F076] animate-ping"></span>
            <span class="text-white font-semibold">PayDart v1.0 Live</span>
            <span class="text-zinc-500">•</span>
            <span class="text-[#00F076]">Air-Gapped & Offline</span>
          </Badge>
        </div>

        <!-- Main Headline in Green & White -->
        <h1 class="hero-anime text-4xl sm:text-6xl lg:text-7xl font-black tracking-tight text-white leading-[1.08] mb-6">
          Scan UPI in <span class="text-gradient-emerald">&lt;10ms.</span><br />
          <span class="text-gradient-green-white">Zero Bloat. Zero Ads.</span>
        </h1>

        <!-- Subtitle -->
        <p class="hero-anime text-zinc-300 text-base sm:text-xl leading-relaxed max-w-2xl mb-8">
          The ultra-lightweight native Android launcher designed for pure speed. Point at any merchant QR code, scan in 8 milliseconds, and hand off directly to your favorite payment app without waiting for slow loaders or ad screens.
        </p>

        <!-- CTA Buttons -->
        <div class="hero-anime flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-10">
          <Button
            variant="primary"
            size="lg"
            href="#download"
            class="w-full sm:w-auto shadow-glow-md"
          >
            <Download class="w-5 h-5 text-black" />
            <span class="font-extrabold">Download APK (4.8 MB)</span>
          </Button>

          <Button
            variant="secondary"
            size="lg"
            href={githubUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto"
          >
            <GithubIcon class="w-5 h-5 text-zinc-300" />
            <span>Star on GitHub</span>
          </Button>
        </div>

        <!-- Quick Proof Metrics Bar -->
        <div class="hero-anime grid grid-cols-2 sm:grid-cols-4 gap-4 w-full max-w-xl pt-6 border-t border-white/10">
          <div class="text-left">
            <div class="text-2xl sm:text-3xl font-mono font-black text-[#00F076]">&lt; 10ms</div>
            <div class="text-xs font-mono text-zinc-400 mt-0.5">Scan Latency</div>
          </div>
          <div class="text-left">
            <div class="text-2xl sm:text-3xl font-mono font-black text-white">4.8 MB</div>
            <div class="text-xs font-mono text-zinc-400 mt-0.5">Lightweight APK</div>
          </div>
          <div class="text-left">
            <div class="text-2xl sm:text-3xl font-mono font-black text-[#00F076]">0 Calls</div>
            <div class="text-xs font-mono text-zinc-400 mt-0.5">100% Offline</div>
          </div>
          <div class="text-left">
            <div class="text-2xl sm:text-3xl font-mono font-black text-white">0 Ads</div>
            <div class="text-xs font-mono text-zinc-400 mt-0.5">Zero Telemetry</div>
          </div>
        </div>
      </div>

      <!-- Right Phone Preview (5 cols) -->
      <div class="lg:col-span-5 flex justify-center hero-anime">
        <PhoneMockup />
      </div>
    </div>
  </div>
</section>
